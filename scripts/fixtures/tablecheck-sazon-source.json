          "booking_services": [
            {
              "id": "679ad6c65cfb12f1c5492a58",
              "service_mode": "dining",
              "show_promo_code": false,
              "merchant_message_translations": [
                {
                  "translation": "<b>WHAT&#39;S ON\r\nMediterranean Made in Bali</b>: 23 October\r\n<b><a href=\"https://www.tablecheck.com/regent-bali-canggu-sazon/reserve/experience/sazonfiesta\">Sazón Fiesta</a>:</b> Thursdays (8 PM until late)\r\n<b><a href=\"https://www.tablecheck.com/regent-bali-canggu-sazon/reserve/experience/paella-class\">Paella Masterclass</a>:</b> With prior booking (6 PM)\r\n\r\nWelcome to Sazón, your neighborhood Mediterranean hideaway on Batu Bolong, where vibrant atmosphere meets authentic flavours. Led by award-winning Chef Andrew Walsh, our open-fire restaurant and bar celebrate the soul of the Mediterranean.\r\n\r\nFor bookings larger than ten people, please reach us on whatsapp.\r\n\r\nFollow us on <a href=\"https://www.instagram.com/sazon.bali/\">Instagram</a> or connect through <a href=\"http://wa.me/6281138316575\">WhatsApp</a> for the latest updates.",
                  "locale": "en"
                }
              ],
              "booking_policy_translations": [
                {
                  "translation": "<b>WHAT&#39;S ON\r\nMediterranean Made in Bali</b>: 23 October\r\n<b><a href=\"https://www.tablecheck.com/regent-bali-canggu-sazon/reserve/experience/sazonfiesta\">Sazón Fiesta</a>:</b> Thursdays (8 PM until late)\r\n<b><a href=\"https://www.tablecheck.com/regent-bali-canggu-sazon/reserve/experience/paella-class\">Paella Masterclass</a>:</b> With prior booking (6 PM)\r\n\r\nWelcome to Sazón, your neighborhood Mediterranean hideaway on Batu Bolong, where vibrant atmosphere meets authentic flavours. Led by award-winning Chef Andrew Walsh, our open-fire restaurant and bar celebrate the soul of the Mediterranean.\r\n\r\nFor bookings larger than ten people, please reach us on whatsapp.\r\n\r\nFollow us on <a href=\"https://www.instagram.com/sazon.bali/\">Instagram</a> or connect through <a href=\"http://wa.me/6281138316575\">WhatsApp</a> for the latest updates.",
                  "locale": "en"
                }
              ],
              "booking_policy_placement": "popup",
              "booking_policy_require_confirm": false,
              "cancel_policy_translations": [
                {
                  "translation": "<b>RESERVATION INFORMATION</b>\r\n• Table will be held for 15 minutes from the confirmed reservation time.\r\n• Kindly inform us of the purpose of your visit (birthday, anniversary, business meeting, etc.) so we may prepare accordingly.\r\n• Should you have any dietary restrictions or allergies, please notify us at the time of booking.\r\n• In the event of bad weather, reservations in the outdoor area will be accommodated without guarantee and subject to availability. \r\n\r\n<b>DINING DURATION</b>\r\n• 120 minutes for parties of 2–7 guests\r\n• 150 minutes for parties of 8 guests and above\r\n\r\n<b>LARGE GROUPS</b>\r\n- For groups of more than ten guests, we kindly ask that reservations be made directly with us via <a href=\"http://wa.me/6281138316575\">WhatsApp</a> or <a href=\"tel:+623612019999\">call</a>.\r\n\r\n<b>DRESS CODE</b>\r\nSmart casual attire is required.\r\n<i>Sportswear, sandals, and sleeveless shirts are not permitted.</i>\r\n",
                  "locale": "en"
                }
              ],
              "prompt_cancel_reason": false,
              "request_policy_translations": [],
              "request_policy_placement": "popup",
              "request_policy_require_confirm": true,
              "waitlist_policy_translations": [],
