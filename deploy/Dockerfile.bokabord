FROM node:22-bookworm-slim
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /opt/velvet-runtime
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npx playwright install --with-deps chromium && ln -s /opt/velvet-runtime/node_modules /node_modules
WORKDIR /app
CMD ["node", "server.mjs"]
